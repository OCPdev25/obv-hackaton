# Shared workspace environment — copy to .env and fill in. Never commit .env.

# Convex dev deployment URL for the mobile client (see apps/mobile/.env.example).
# The DeviceProof harness (apps/mobile/src/device-proof) uses this URL to run the
# 3-request photo upload against the real dev deployment when set; when unset it
# falls back to a deterministic in-memory fake transport (rows are labeled with
# which transport produced them). No credentials belong in this file.
EXPO_PUBLIC_CONVEX_URL=
