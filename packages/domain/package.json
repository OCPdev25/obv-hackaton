{
  "name": "@journal/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Effect v4 schemas (domain authority), capture state machine, service interfaces, and command definitions",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
