# Convex dev deployment URL — shown by `npx convex dev` after `npx convex login`.
# Example: https://reliable-panther-823.convex.cloud
EXPO_PUBLIC_CONVEX_URL=

# Parent-home A/B candidate: set to "b" to render candidate B (Today feed-first
# home with the persistent composer — in-memory synthetic data, no live Convex
# needed). Leave empty for the default Convex-backed shell.
EXPO_PUBLIC_HOME_CANDIDATE=
