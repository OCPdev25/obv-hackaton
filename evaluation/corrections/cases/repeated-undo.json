{
  "cases": [
    {
      "id": "CC-12-repeated-corrections-idempotent",
      "category": "repeated-corrections-and-undo",
      "description": "Two sequential corrections of the same field (2:15 → 2:30 → 2:45), then the second correction replays verbatim. Final value 14:45, exactly two correction revisions, replay is a no-op.",
      "exercises": ["sequential corrections keep the full intermediate lineage", "idempotent replay produces no duplicate revision", "no collapsed single revision"],
      "setup": {
        "turns": [
          {
            "turnId": "s1",
            "captureId": "fx_cc12_nap",
            "speakerId": "fx_u_dad",
            "capturedAt": 1789496400000,
            "text": "Nora went down for her nap at 2:15.",
            "seedEvents": [
              { "category": "sleep", "occurredAt": 1789496100000, "note": "nap" }
            ]
          }
        ],
        "baseline": { "entryCount": 1 }
      },
      "turns": [
        {
          "turnId": "t1",
          "speakerId": "fx_u_dad",
          "capturedAt": 1789496700000,
          "text": "Actually, two thirty.",
          "correctionId": "cc12-t1",
          "expect": {
            "responseClass": "applied",
            "stateDelta": {
              "entryChanges": [
                { "ofCaptureId": "fx_cc12_nap", "events": [{ "category": "sleep", "occurredAt": 1789497000000 }] }
              ],
              "appendedRevisions": [
                { "ofCaptureId": "fx_cc12_nap", "kind": "correction", "authorId": "fx_u_dad", "count": 1 }
              ]
            }
          }
        },
        {
          "turnId": "t2",
          "speakerId": "fx_u_dad",
          "capturedAt": 1789496880000,
          "text": "No wait — 2:45.",
          "correctionId": "cc12-t2",
          "expect": {
            "responseClass": "applied",
            "stateDelta": {
              "entryChanges": [
                { "ofCaptureId": "fx_cc12_nap", "events": [{ "category": "sleep", "occurredAt": 1789497900000 }] }
              ],
              "appendedRevisions": [
                { "ofCaptureId": "fx_cc12_nap", "kind": "correction", "authorId": "fx_u_dad", "count": 1 }
              ]
            }
          }
        }
      ],
      "replay": {
        "turnIndex": 1,
        "note": "cc12-t2 re-sent verbatim (same correctionId) — idempotency probe.",
        "expectResponseClass": "applied"
      },
      "final": {
        "entryCount": 1,
        "entries": [
          {
            "ofCaptureId": "fx_cc12_nap",
            "childId": "fx_child_nora",
            "authorId": "fx_u_dad",
            "status": "draft",
            "transcriptByteEquals": "Nora went down for her nap at 2:15.",
            "events": [{ "category": "sleep", "occurredAt": 1789497900000 }],
            "revisionKinds": ["capture", "correction", "correction"],
            "lastRevisionAuthorId": "fx_u_dad"
          }
        ]
      },
      "forbidden": [
        "idempotent.duplicate_revision",
        "lineage.truncate",
        "entry.delete",
        "raw.mutate"
      ]
    },
