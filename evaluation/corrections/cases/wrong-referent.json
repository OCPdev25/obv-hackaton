    {
      "id": "CC-06-wrong-prior-event-ambiguous-referent",
      "category": "wrong-prior-event",
      "description": "Two same-day meal entries from different authors. The correction names distinguishing content (\"not pasta\"), which binds it to Mom's lunch — not the most recent entry overall (Dad's dinner). Binding proposal: content-mention filter first, then speaker's most recent; ambiguous beyond that → clarify.",
      "exercises": ["content-referent binding over recency", "wrong-entry application forbidden", "untouched sibling entry unchanged"],
      "setup": {
        "turns": [
          {
            "turnId": "s1",
            "captureId": "fx_cc06_lunch",
            "speakerId": "fx_u_mom",
            "capturedAt": 1789489200000,
            "text": "Nora had pasta at noon.",
            "seedEvents": [
              { "category": "meal", "occurredAt": 1789488000000, "note": "pasta at noon" }
            ]
          },
