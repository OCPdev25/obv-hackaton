              { "category": "meal", "occurredAt": 1789509600000, "note": "chicken at 6" }
            ]
          }
        ],
        "baseline": { "entryCount": 2 }
      },
      "turns": [
        {
          "turnId": "t1",
          "speakerId": "fx_u_mom",
          "capturedAt": 1789511100000,
          "text": "Actually, it was rigatoni, not pasta.",
          "correctionId": "cc06-t1",
          "expect": {
