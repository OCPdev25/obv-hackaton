            "captureId": "fx_cc03_meal",
            "speakerId": "fx_u_mom",
            "capturedAt": 1789489200000,
            "text": "Leo ate all his pasta at noon.",
            "seedEvents": [
              { "category": "meal", "occurredAt": 1789488000000, "note": "pasta at noon" }
            ]
          }
