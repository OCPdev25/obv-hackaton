          "correctionId": "cc03-t1",
          "expect": {
            "responseClass": "applied",
            "stateDelta": {
              "entryChanges": [
                {
                  "ofCaptureId": "fx_cc03_meal",
                  "childId": "fx_child_mia",
                  "authorIdMustRemain": "fx_u_mom",
                  "transcriptUnchanged": true,
                  "events": [{ "category": "meal", "occurredAt": 1789488000000 }]
                }
              ],
              "appendedRevisions": [
                { "ofCaptureId": "fx_cc03_meal", "kind": "correction", "authorId": "fx_u_mom", "count": 1 }
              ]
            }
          }
        }
      ],
      "final": {
        "entryCount": 1,
        "entries": [
          {
            "ofCaptureId": "fx_cc03_meal",
            "childId": "fx_child_mia",
            "authorId": "fx_u_mom",
            "status": "draft",
            "transcriptByteEquals": "Leo ate all his pasta at noon.",
            "events": [{ "category": "meal", "occurredAt": 1789488000000 }],
            "revisionKinds": ["capture", "correction"],
            "lastRevisionAuthorId": "fx_u_mom"
          }
        ]
      },
      "forbidden": [
        "entry.duplicate_without_supersession",
        "event.retarget_without_lineage",
        "raw.mutate",
        "entry.delete",
        "revision.attribution_rewrite"
      ]
    },
